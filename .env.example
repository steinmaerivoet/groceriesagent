# Copy to .env (make setup does this for you). Dev-only defaults.
MEALIE_VERSION=v3.28.0
MEALIE_PORT=9925
MEALIE_BASE_URL=http://localhost:9925
TZ=Europe/Brussels

POSTGRES_USER=mealie
POSTGRES_PASSWORD=mealie
POSTGRES_DB=mealie

# Mealie's built-in default admin (change it in the UI if you like; the seeder logs in with these)
MEALIE_ADMIN_EMAIL=changeme@example.com
MEALIE_ADMIN_PASSWORD=MyPassword

# Filled in by `make seed`: long-lived API token for the Grocery Core
MEALIE_API_TOKEN=

# Telegram bot for the chat POC (core/chat). Leave empty to use the console demo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
